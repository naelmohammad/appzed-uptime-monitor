{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appzed-uptime-monitor",
  "main": "worker.js",
  "compatibility_date": "2026-10-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "appzed-uptime-monitor-meta"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
